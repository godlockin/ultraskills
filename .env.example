# UltraSkills Environment Configuration
# Copy this file to .env and fill in your values

# =============================================
# LLM API Keys (for skill-arena and AI features)
# =============================================

# Anthropic API (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API
OPENAI_API_KEY=sk-...

# Google API
GOOGLE_API_KEY=...

# Azure OpenAI API
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# =============================================
# Skill Arena Configuration
# =============================================

# Default LLM provider for skill-arena (anthropic, openai, google)
SKILL_ARENA_PROVIDER=anthropic

# Default model for skill-arena
SKILL_ARENA_MODEL=claude-sonnet-4-20250514

# Number of parallel workers for benchmark testing
SKILL_ARENA_WORKERS=4

# =============================================
# GitHub Integration (for skill management)
# =============================================

# GitHub Token (for skill-sync-manager and GitHub operations)
GITHUB_TOKEN=ghp_...

# =============================================
# Database (optional - for result persistence)
# =============================================

# PostgreSQL (if using database for results)
DATABASE_URL=postgresql://user:password@localhost:5432/skill_arena

# =============================================
# Optional Services
# =============================================

# Trackio (for experiment tracking)
TRACKIO_API_KEY=...

# Slack webhook (for notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
